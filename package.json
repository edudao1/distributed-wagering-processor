{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun scripts/migrate.ts up",
    "db:rollback": "bun scripts/migrate.ts down",
    "sqs:setup": "bun scripts/setup-sqs.ts",
    "infra:up": "docker compose up -d postgres localstack",
    "infra:down": "docker compose down -v",
    "test": "bun test --timeout 120000",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test --timeout 120000 tests/integration",
    "test:concurrency": "bun test --timeout 180000 tests/concurrency",
    "test:load": "bun scripts/load-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/migrations": "^6.4.0",
    "@mikro-orm/postgresql": "^6.4.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "decimal.js": "^10.4.3",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "prom-client": "^15.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3"
  }
}
