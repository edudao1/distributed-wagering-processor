PORT=3000
INSTANCE_ID=local-1
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=20000

DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering
DB_POOL_MAX=20
DB_LOCK_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wagering-events.fifo
SQS_CONSUMER_ENABLED=true
SQS_CONSUMER_NAME=wagering-processor
SQS_CONSUMER_CONCURRENCY=4
SQS_BATCH_SIZE=10
SQS_WAIT_TIME_SECONDS=10
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_MAX_RECEIVES=5
SQS_RETRY_BASE_DELAY_SECONDS=2
SQS_RETRY_MAX_DELAY_SECONDS=300

OUTBOX_ENABLED=true
OUTBOX_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000

PENDING_REFERENCE_ENABLED=true
PENDING_REFERENCE_INTERVAL_MS=1000
PENDING_REFERENCE_BATCH_SIZE=50
PENDING_REFERENCE_MAX_ATTEMPTS=10
PENDING_REFERENCE_BASE_DELAY_MS=1000
PENDING_REFERENCE_MAX_DELAY_MS=60000
